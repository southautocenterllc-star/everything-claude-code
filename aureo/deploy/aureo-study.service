[Unit]
Description=AUREO estudio constante (aprendizaje, determinístico)
After=aureo-mt5-terminal.service nss-lookup.target network-online.target
Wants=aureo-mt5-terminal.service network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/datos/holding/aureo
Environment=PYTHONUNBUFFERED=1
Environment=WINEPREFIX=/mnt/datos/holding/aureo/data/mt5/wineprefix
Environment=WINEDEBUG=-all
Environment=DISPLAY=:0
ExecStart=/mnt/datos/holding/aureo/.venv/bin/python -m research.study_loop --daemon --poll 43200
Restart=always
RestartSec=60

[Install]
WantedBy=default.target

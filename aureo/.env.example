# ============================================================================
# AUREO — config de ejemplo. Copia a .env y rellena con LO TUYO.
# El .env real NUNCA se commitea (está en .gitignore). Guía: REPLICAR_AUREO.md
# ============================================================================

# --- Telegram (tu propio bot) -----------------------------------------------
# Crea un bot con @BotFather (/newbot) → te da el token.
AUREO_TG_BOT_TOKEN=123456789:TU_TOKEN_DE_BOTFATHER
# Usernames (sin @) autorizados a mandarle comandos al bot, separados por coma.
AUREO_TG_ALLOWED_USERS=tu_username
# chat_id(s) destino de las alertas/broadcast, separados por coma.
# Para un grupo es negativo (p.ej. -100123...). Sácalo escribiéndole al bot y
# mirando https://api.telegram.org/bot<TOKEN>/getUpdates
AUREO_TG_BROADCAST_CHATS=-100xxxxxxxxxx

# --- MetaTrader 5 demo (vía Wine) -------------------------------------------
# Cuenta DEMO de cualquier broker. El server DEBE contener "Demo" o la traba de
# seguridad no deja operar (ver REPLICAR_AUREO.md sección 7, gotcha #5).
MT5_LOGIN=10000000000
MT5_PASSWORD=tu_password_demo
MT5_SERVER=MetaQuotes-Demo
# Interruptores de seguridad de ejecución:
AUREO_MT5_ALLOW_DEMO_TRADE=1   # 1 = permite operar la DEMO. Déjalo en 1 para operar.
AUREO_ALLOW_LIVE=0             # 1 = permitiría cuenta REAL. NO lo toques sin edge validado.

# --- Webhook (opcional: camino TradingView/Vercel → Telegram) ---------------
# Secreto compartido que valida el payload entrante. Genera uno aleatorio largo:
#   python -c "import secrets; print('aureo_'+secrets.token_urlsafe(32))"
WEBHOOK_SECRET=aureo_REGENERA_UN_STRING_ALEATORIO_LARGO
AUREO_WEBHOOK_BASE=http://127.0.0.1:8080
# URL pública del receptor (si despliegas la función serverless propia):
AUREO_WEBHOOK_URL=

# --- Feeds de datos (opcionales: sin estas keys cae a Yahoo / solo FOMC) ----
# Feed de oro premium. Sin ella, core/data_feed.py usa Yahoo (GC=F) gratis.
TWELVEDATA_API_KEY=
# Calendario macro real (NFP/CPI). Gratis en https://fred.stlouisfed.org/docs/api/api_key.html
# Sin ella, el event study trabaja solo con FOMC.
FRED_API_KEY=

# --- IA (opcional: el core NO la necesita) ----------------------------------
# Solo si reactivas alguna capa de interpretación con Claude. El bucle de
# trading es 100% determinista y no usa LLM (regla de diseño).
ANTHROPIC_API_KEY=
